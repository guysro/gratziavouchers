PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/gratzia_vouchers
ADMIN_PASSWORD=replace_with_a_long_random_password_at_least_16_chars
# Development defaults to vouchers_dev; production defaults to vouchers.
# Optional collection-name overrides:
# MONGODB_COLLECTION_DEVELOPMENT=vouchers_dev
# MONGODB_COLLECTION_PRODUCTION=vouchers
# Required on Vercel: use a stable, randomly generated secret of at least 32 bytes
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
# Optional: set only if Node.js reports querySrv ECONNREFUSED
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
