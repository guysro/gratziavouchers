PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/gratzia_vouchers
ADMIN_PASSWORD=replace_with_a_long_random_password_at_least_16_chars
# Development defaults to vouchers_dev; production defaults to vouchers.
# Optional collection-name overrides:
# MONGODB_COLLECTION_DEVELOPMENT=vouchers_dev
# MONGODB_COLLECTION_PRODUCTION=vouchers
# Required on Vercel: use a stable, randomly generated secret of at least 32 bytes
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
# PayPal webhook ID (PayPal developer dashboard -> your app -> Webhooks).
# Subscribe the webhook to CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED.
PAYPAL_WEBHOOK_ID=
# WhatsApp Cloud API (Meta) - sends the voucher PDF to the buyer. Leave the
# token empty to disable. See README "WhatsApp delivery".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=voucher_delivery
WHATSAPP_TEMPLATE_LANGUAGE=he
# Prefix used for local numbers that start with 0 (e.g. 050-1234567)
WHATSAPP_DEFAULT_COUNTRY_CODE=972
# WHATSAPP_API_VERSION=v23.0
# Days to keep event logs in MongoDB (<collection>_logs). Default 180.
# LOG_RETENTION_DAYS=180
# Standalone only (ignored on Vercel): number of reverse proxies in front of
# Express, e.g. 1 behind nginx. Leave unset when Express faces clients directly.
# TRUST_PROXY=1
# Optional: set only if Node.js reports querySrv ECONNREFUSED
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
